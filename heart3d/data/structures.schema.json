{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "heart3d/data/structures.schema.json",
  "title": "3D Heart structure cards (Step 7; v3: glance layer + SAQs, 14 Nov 2026)",
  "description": "One card per teachable structure. Written by Claude, reviewed by Punnatorn + cardiology staff. Codex renders it (T7.1) and never edits the text. Short names on the model stay in explore-data.js SHORT (one source); the card shows `name`.",
  "type": "object",
  "required": [
    "meta",
    "cards"
  ],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "version",
        "levels"
      ],
      "properties": {
        "version": {
          "type": "string"
        },
        "levels": {
          "type": "array",
          "items": {
            "enum": [
              "student",
              "resident",
              "fellow"
            ]
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/card"
      }
    }
  },
  "$defs": {
    "ref": {
      "description": "A place the structure is seen. `id` must exist in its namespace (echo: echo-sim/data/views.json ids; cut: explore.js CUTS ids / RELEVANT_LABELS keys). `text` says what to look for.",
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "layer",
        "labelIds",
        "core",
        "anatomy",
        "function",
        "supply",
        "complications",
        "pearls",
        "sources",
        "review",
        "stats",
        "quick",
        "saq"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable card id. Never renamed once published."
        },
        "name": {
          "type": "string",
          "description": "Full name, card title."
        },
        "category": {
          "type": "string",
          "description": "Small caps line above the title, e.g. 'Chamber', 'Valve', 'Coronary artery', 'Conduction'."
        },
        "layer": {
          "enum": [
            "chambers",
            "valves",
            "vessels",
            "conduction",
            "landmarks",
            "pericardium"
          ],
          "description": "Layer id from explore-data.js LAYERS."
        },
        "labelIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Every tap id that opens this card: phantom label ids, landmark ids, 'artery:<id>', 'vein:<id>', 'conduction:<tap id>'. Each tap id belongs to exactly one card (checked by the validator)."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parts": {
          "type": "array",
          "description": "Sub-parts named on tap (leaflets, cusps, scallops, segments). A tap on `labelId` opens the card scrolled to this part and the callout reads '<name> — <part name>'. Replaces explore-data.js LEAFLET.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "note"
            ],
            "additionalProperties": false,
            "properties": {
              "labelId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "core": {
          "type": "string",
          "maxLength": 200,
          "description": "One sentence: what it is and why it matters. Always visible, also on phones."
        },
        "anatomy": {
          "$ref": "#/$defs/layered"
        },
        "function": {
          "$ref": "#/$defs/layered"
        },
        "supply": {
          "$ref": "#/$defs/layered"
        },
        "relations": {
          "type": "array",
          "description": "Neighbours that explain a complication or a procedure risk.",
          "items": {
            "type": "object",
            "required": [
              "with",
              "why"
            ],
            "additionalProperties": false,
            "properties": {
              "with": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "focus": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "seenOn": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "echo": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ref"
              }
            },
            "cut": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ref"
              }
            },
            "ct": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ref"
              }
            },
            "ecg": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ref"
              }
            }
          }
        },
        "complications": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "mechanism",
              "presentation",
              "scenario",
              "hook"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "mechanism": {
                "type": "string"
              },
              "presentation": {
                "type": "string"
              },
              "scenario": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Existing pathology scenario id (CONTENT.SC, SIMC.EXTRA, SIMC.MIS keys) → 'Run in simulator'. 'planned:<id>' → greyed chip 'Coming with the Pathology simulator'. null → no chip."
              },
              "hook": {
                "type": "string",
                "maxLength": 60,
                "description": "One-line summary shown in the collapsed complication row and the side panel."
              }
            }
          }
        },
        "pearls": {
          "type": "object",
          "required": [
            "student",
            "resident"
          ],
          "additionalProperties": false,
          "description": "Student and resident: 2–4 each (priority audience). Fellow: optional, 0–3; when empty the Fellow button is greyed with 'Fellow pearls coming later'. Each pearl = {hook (≤ 8 words, shown bold), text (the answer/explanation)}.",
          "properties": {
            "student": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "hook",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "hook": {
                    "type": "string",
                    "maxLength": 48
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "resident": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "hook",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "hook": {
                    "type": "string",
                    "maxLength": 48
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            },
            "fellow": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "type": "object",
                "required": [
                  "hook",
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "hook": {
                    "type": "string",
                    "maxLength": 48
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "Tags only (guideline, textbook, review). No copied text."
        },
        "verify": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Claims for staff to check (numbers, contested anatomy). Shown on the review sheet, not on the public card."
        },
        "review": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "draft",
                "staff-checked"
              ]
            },
            "batch": {
              "type": "string"
            },
            "by": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "stats": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "description": "Number badges in the side panel: the 2–3 numbers worth remembering.",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 22
              },
              "label": {
                "type": "string",
                "maxLength": 28
              }
            }
          }
        },
        "quick": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "description": "High-yield bites for the desktop side panel (and the top of the phone card). **bold** marks the key words. `focus` = tap ids lit on the model while the pointer is over the bite.",
          "items": {
            "type": "object",
            "required": [
              "icon",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "icon": {
                "enum": [
                  "where",
                  "does",
                  "supply",
                  "danger",
                  "ecg",
                  "echo",
                  "exam",
                  "key"
                ]
              },
              "text": {
                "type": "string",
                "maxLength": 110
              },
              "focus": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "saq": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "description": "Short-answer questions (14 Nov; replace 'Quiz me'). The learner types an answer, presses 'Check', then sees the model answer and ticks the key points (self-marking, not stored). Shown by the chosen level; Student and Resident first.",
          "items": {
            "type": "object",
            "required": [
              "level",
              "q",
              "a",
              "keys"
            ],
            "additionalProperties": false,
            "properties": {
              "level": {
                "enum": [
                  "student",
                  "resident",
                  "fellow"
                ]
              },
              "q": {
                "type": "string",
                "maxLength": 200
              },
              "a": {
                "type": "string"
              },
              "keys": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "maxLength": 60
                }
              }
            }
          }
        }
      }
    },
    "layered": {
      "type": "object",
      "required": [
        "summary",
        "detail"
      ],
      "additionalProperties": false,
      "description": "Summary first (one line, shown as the section's opening line), detail after (shown on expand).",
      "properties": {
        "summary": {
          "type": "string",
          "maxLength": 160
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
